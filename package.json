{
  "name": "dsh-skin-kurisu",
  "version": "1.12.7",
  "description": "Makise Kurisu (Amadeus) skin for DeepSeek Harness — macOS/Linux port with night-blue translucent surfaces, tie-crimson accents, four switchable Kurisu wallpapers, a five-step wallpaper-density control, and a custom wallpaper picker. 牧濑红莉栖主题 DSH 皮肤（macOS 适配版）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "src",
    "build.mjs",
    "install.sh",
    "uninstall.sh",
    "tools"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "kurisu",
    "makise-kurisu",
    "steins-gate",
    "wallpaper"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
